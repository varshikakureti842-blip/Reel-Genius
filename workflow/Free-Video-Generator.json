      "id": "8f76eecc-6b10-41c3-b6ed-4d883b86281c",
      "name": "Check Render Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2896,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const root = $input.first().json || {};\n// Shotstack's HTTP response wraps render metadata in root.response. Its nested\n// response.data contains the timeline, not the render status or output URL.\nconst candidates = [root.response, root.data, root.response?.data, root];\nconst d = candidates.find(x => x && typeof x === 'object' && (x.status || x.url || x.id)) || root.response || root.data || root;\nconst status = d.status || d.attributes?.status || root.status || 'unknown';\nconst url = d.url || d.attributes?.url || d.output?.url || root.response?.url || root.url || null;\nconst renderId = d.id || d.attributes?.id || root.response?.id || root.id || null;\nreturn [{json:{status,video_url:url,render_id:renderId,message:url ? 'Video rendered successfully. Open video_url to watch or download it.' : 'Render is not complete yet. Wait and check the render status again.',title:$('Collect Clips').first().json.title}}];"
      },
      "id": "edffbae8-f74c-4c79-993b-f33242d8e3f9",
      "name": "Return Video Link",
